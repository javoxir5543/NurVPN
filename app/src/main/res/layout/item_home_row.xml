<?xml version="1.0" encoding="utf-8"?>
<!--
  ★ FIX141-CARDSTYLE: karta ichidagi server qatori.

  ═══ MUAMMO ═══

  RecyclerView'ga o'tkazgandan keyin qatorlar kartadan TASHQARIDA
  ko'rindi — chunki har bir qator alohida item bo'ldi va unda
  karta foni (bg_card) yo'q edi.

  ═══ YECHIM ═══

  Har bir qatorga karta fonini qo'shamiz (chap/o'ng tomoni kartaga
  tegib turadi). Shu bilan qatorlar vizual ravishda BITTA karta
  ichida ko'rinadi.

  Padding: 14dp yon tomondan (eski `body.setPadding(14,0,14,8)` kabi)
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true"
    android:background="?android:attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <View
            android:id="@+id/select_check"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginEnd="6dp"
            android:visibility="gone"
            android:clickable="false"
            android:focusable="false"
            android:background="@drawable/select_dot"/>

        <TextView
            android:id="@+id/row_flag"
            android:layout_width="32dp"
            android:layout_height="wrap_content"
            android:textSize="20sp"
            android:gravity="center"
            android:text="🌍"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/row_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/row_proto"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_chip_small"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    android:textColor="#0A1410"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:text="@string/row_proto_default"/>

                <TextView
                    android:id="@+id/row_host"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:textColor="@color/text_tertiary"
                    android:textSize="10sp"
                    android:maxLines="1"
                    android:ellipsize="end"/>
            </LinearLayout>
        </LinearLayout>

        <ImageView
            android:id="@+id/row_fav"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_marginStart="6dp"
            android:padding="3dp"
            android:src="@android:drawable/btn_star_big_off"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/chip_fav"/>

        <TextView
            android:id="@+id/row_ping"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:textColor="@color/text_tertiary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:text="---"/>
    </LinearLayout>
</LinearLayout>
