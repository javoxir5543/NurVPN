<?xml version="1.0" encoding="utf-8"?>
<!--
  ★ FIX140-HOMERV: Home ekrani endi RecyclerView.

  ═══ NEGA ═══

  Avval `ScrollView` + `LinearLayout` edi. Karta ochilganda 200 ta
  `inflate()` bajarilardi (2 sekund, 135 kadr tashlanardi).

  RecyclerView faqat KO'RINADIGAN qatorlarni yaratadi va scroll
  paytida ularni QAYTA ISHLATADI — Servers bo'limidagi kabi.

  ═══ TUZILISH ═══

    Item 0   : Header (traffic, timer, SpeedWave, tugmalar, AWG)
    Item 1..N: Server kartalari (sarlavha) va ochilgan qatorlar

  `home_scroll_root` id SAQLANDI — kod unga murojaat qilsa
  (masalan scroll pozitsiyasi) ishlashda davom etadi.
-->
<androidx.recyclerview.widget.RecyclerView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/home_scroll_root"
    android:saveEnabled="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:scrollbars="none"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="24dp"
    android:clipToPadding="false"/>
