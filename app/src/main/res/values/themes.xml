<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.NurVPN" parent="Theme.Material3.DayNight.NoActionBar">

        <item name="colorPrimary">@color/accent</item>
        <item name="colorOnPrimary">@color/on_accent</item>
        <item name="colorPrimaryContainer">@color/accent_dim</item>
        <item name="colorOnPrimaryContainer">@color/on_accent</item>
        <item name="colorSecondary">@color/accent_dim</item>
        <item name="colorOnSecondary">@color/on_accent</item>

        <item name="colorSurface">@color/card_bg</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorSurfaceVariant">@color/surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorOutline">@color/card_border</item>
        <item name="colorOutlineVariant">@color/divider</item>

        <item name="colorError">@color/danger</item>
        <item name="colorOnError">@color/text_primary</item>

        <item name="android:colorBackground">@color/bg</item>
        <item name="colorOnBackground">@color/text_primary</item>

        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/nav_bg</item>

        <!-- KUNDUZ: qora ikonkalar -->
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:enforceStatusBarContrast" tools:targetApi="q">false</item>
        <item name="android:enforceNavigationBarContrast" tools:targetApi="q">false</item>

        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorHint">@color/text_tertiary</item>

        <item name="materialCardViewStyle">@style/NV.Card</item>
        <item name="bottomNavigationStyle">@style/NV.BottomNav</item>
        <item name="materialButtonStyle">@style/NV.Button</item>
    </style>

    <style name="NV.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/card_bg</item>
        <item name="strokeColor">@color/card_border</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">0dp</item>
    </style>

    <style name="NV.BottomNav" parent="Widget.Material3.BottomNavigationView">
        <item name="android:background">@color/nav_bg</item>
        <item name="itemIconTint">@color/nav_item_tint</item>
        <item name="itemTextColor">@color/nav_item_tint</item>
        <item name="itemRippleColor">@color/nav_ripple</item>
        <item name="labelVisibilityMode">labeled</item>
        <item name="itemActiveIndicatorStyle">@style/NV.BottomNav.Indicator</item>
        <item name="elevation">0dp</item>
    </style>

    <style name="NV.BottomNav.Indicator"
           parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/nav_indicator</item>
        <item name="android:width">56dp</item>
        <item name="android:height">32dp</item>
    </style>

    <style name="NV.Button" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/accent</item>
        <item name="android:textColor">@color/on_accent</item>
        <item name="cornerRadius">16dp</item>
        <item name="rippleColor">@color/accent_ripple</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0.0</item>
    </style>

    <style name="NV.Chip" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/chip_bg</item>
        <item name="chipStrokeColor">@color/chip_stroke</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="android:textColor">@color/chip_text_tint</item>
        <item name="chipIconTint">@color/chip_text_tint</item>
        <item name="checkedIconVisible">false</item>
        <item name="chipCornerRadius">20dp</item>
    </style>

</resources>
