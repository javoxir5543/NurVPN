    private fun addAWG(conf: String) {
        val a = activity as? MainActivity ?: return
        val r = AWGParser.parse(conf)
        if (!r.ok) {
            Toast.makeText(context, r.error, Toast.LENGTH_LONG).show()
            return
        }
        val cfg = AWGConfig(conf)
        cfg.endpoint = r.endpoint
        cfg.address = r.address
        cfg.name = "AWG " + r.endpoint
        a.awgConfigs.add(cfg)
        AWGStore.save(a, a.awgConfigs)
        a.selectAWG(cfg)
        a.protocol = MainActivity.PROTO_AWG
        AWGEditorBus.init(a.awgConfigs, cfg, MainActivity.PROTO_AWG)
        ad?.notifyDataChanged()
        Toast.makeText(context, "AWG v${r.version} qo'shildi", Toast.LENGTH_SHORT).show()
    }

    private fun showSubDialog() {
        if (!isAdded) return
        val et = EditText(requireContext())
        et.hint = "https://example.com/sub/xxx"
        AlertDialog.Builder(requireContext())
            .setTitle(R.string.dialog_add_sub)
            .setView(et)
            .setPositiveButton(R.string.dialog_load) { _, _ ->
                val url = et.text.toString().trim()
                if (url.isNotEmpty()) loadSub(url)
            }
            .setNegativeButton(R.string.dialog_no, null)
            .show()
    }

    private fun loadSub(url: String) {
        Toast.makeText(context, "Yuklanmoqda...", Toast.LENGTH_SHORT).show()
        Thread {
            val lines = fetchSub(url)
            val links = ArrayList<String>()
            for (l in lines) {
                if (l.startsWith("vless://") || l.startsWith("vmess://") ||
                    l.startsWith("trojan://") || l.startsWith("ss://") ||
                    l.startsWith("hy2://") || l.startsWith("hysteria2://")
                ) links.add(l)
            }
            if (!isAdded) return@Thread
            activity?.runOnUiThread {
                val a = activity as? MainActivity ?: return@runOnUiThread
                var added = 0
                for (l in links) {
                    val si = parseServer(l)
                    if (si != null) { a.servers.add(si); added++ }
                }
                ServerStore.save(a, a.servers)
                ad?.notifyDataChanged()
                Toast.makeText(context, "$added ta qo'shildi", Toast.LENGTH_SHORT).show()
            }
        }.start()
    }

    private fun fetchSub(urlStr: String): Array<String> {
        return try {
            val u = java.net.URL(urlStr)
            val c = u.openConnection() as java.net.HttpURLConnection
            c.connectTimeout = 10000
            c.readTimeout = 10000
            val br = BufferedReader(InputStreamReader(c.inputStream))
            val sb = StringBuilder()
            var line: String?
            while (br.readLine().also { line = it } != null) sb.append(line).append("\n")
            br.close()
            var body = sb.toString()
            try {
                val dec = android.util.Base64.decode(body.trim(),
                    android.util.Base64.DEFAULT)
                body = String(dec, Charsets.UTF_8)
            } catch (ignored: Throwable) {}
            body.split(Regex("\\R")).toTypedArray()
        } catch (t: Throwable) {
            emptyArray()
        }
    }

    private fun addLink(link: String) {
        val a = activity as? MainActivity ?: return
        val si = parseServer(link)
        if (si == null) {
            Toast.makeText(context, R.string.toast_invalid_link, Toast.LENGTH_SHORT).show()
            return
        }
        a.servers.add(si)
        ServerStore.save(a, a.servers)
        ad?.notifyDataChanged()
        Toast.makeText(context, R.string.toast_added, Toast.LENGTH_SHORT).show()
    }

    private fun parseServer(link: String?): ServerItem? {
        if (link.isNullOrEmpty()) return null
        return try {
            val si = ServerItem(link)
            var body = link
            val hash = body.indexOf('#')
            if (hash > 0) {
                si.remark = android.net.Uri.decode(body.substring(hash + 1))
                body = body.substring(0, hash)
            }
            val at = body.indexOf('@')
            if (at > 0) {
                var hostPort = body.substring(at + 1)
                val q = hostPort.indexOf('?')
                if (q > 0) hostPort = hostPort.substring(0, q)
                val slash = hostPort.indexOf('/')
                if (slash > 0) hostPort = hostPort.substring(0, slash)
                val colon = hostPort.lastIndexOf(':')
                if (colon > 0) {
                    si.host = hostPort.substring(0, colon)
                    si.port = try {
                        hostPort.substring(colon + 1).toInt()
                    } catch (e: Exception) { 0 }
                } else si.host = hostPort
            }
            val cc = CountryLookup.lookup(si.host)
            si.countryCode = cc[0]
            si.country = cc[1]
            if (si.remark.isNullOrEmpty()) si.remark = si.host
            si
        } catch (t: Throwable) { null }
    }

    // ───────── ADAPTER ─────────
    private inner class ServerAdapter(
        private val frag: ServersFragment,
        private val act: MainActivity?
    ) : RecyclerView.Adapter<ServerAdapter.VH>() {

        private val all = ArrayList<Any>()
        private val shown = ArrayList<Any>()
        private var currentQuery = ""

        init { rebuild() }

        fun rebuild() {
            all.clear()
            act?.servers?.forEach { if (it != null) all.add(it) }
            act?.awgConfigs?.forEach { if (it != null) all.add(it) }
            applyFilter()
        }

        fun notifyDataChanged() { rebuild(); notifyDataSetChanged() }

        private fun applyFilter() {
            shown.clear()
            if (currentQuery.isEmpty()) shown.addAll(all)
            else {
                val q = currentQuery.lowercase()
                for (o in all) {
                    val n = if (o is ServerItem) o.displayName()
                            else (o as AWGConfig).name
                    if (n != null && n.lowercase().contains(q)) shown.add(o)
                }
            }
        }

        fun filter(q: String) {
            currentQuery = q
            applyFilter()
            notifyDataSetChanged()
        }

        @NonNull
        override fun onCreateViewHolder(@NonNull p: ViewGroup, v: Int): VH {
            val item = LayoutInflater.from(p.context)
                .inflate(R.layout.item_server, p, false)
            return VH(item)
        }

        override fun onBindViewHolder(@NonNull h: VH, pos: Int) {
            val o = shown[pos]
            h.itemView.setOnLongClickListener(null)
            h.itemView.setOnClickListener(null)
            when (o) {
                is ServerItem -> bindServer(h, o)
                is AWGConfig -> bindAWG(h, o)
            }
            h.fav?.visibility = View.GONE
        }

        private fun bindServer(h: VH, s: ServerItem) {
            h.flag.text = s.flag()
            h.name.text = s.displayName()
            h.addr.text = (s.host ?: "?") + (if (s.port > 0) ":${s.port}" else "")

            if (SingBoxConfig.isHysteria2Link(s.link)) {
                h.aiScore?.visibility = View.VISIBLE
                h.aiScore?.text = "HY2"
                h.aiScore?.setTextColor(0xFF7B5CFF.toInt())
            } else if (h.aiScore != null) {
                val c = frag.context
                if (c != null) {
                    val m = MetricsStore.get(c, s.link)
                    if (m.samples > 0) {
                        val sc = SmartScoreEngine.computeScore(m,
                            System.currentTimeMillis())
                        h.aiScore.visibility = View.VISIBLE
                        h.aiScore.text = String.format(Locale.US, "AI %.0f", sc)
                        h.aiScore.setTextColor(
                            if (sc >= 75) 0xFF4CD964.toInt()
                            else if (sc >= 50) 0xFFFFC107.toInt()
                            else 0xFFE74C3C.toInt())
                    } else h.aiScore.visibility = View.GONE
                }
            }

            when {
                s.ping < 0 -> { h.ping.text = "---"; h.ping.setTextColor(0xFF888888.toInt()) }
                s.ping >= 9999 -> { h.ping.text = "✕"; h.ping.setTextColor(0xFFE74C3C.toInt()) }
                s.ping < 100 -> { h.ping.text = "${s.ping}ms"; h.ping.setTextColor(0xFF4CD964.toInt()) }
                s.ping < 300 -> { h.ping.text = "${s.ping}ms"; h.ping.setTextColor(0xFFFFC107.toInt()) }
                else -> { h.ping.text = "${s.ping}ms"; h.ping.setTextColor(0xFFE74C3C.toInt()) }
            }

            val selected = act?.currentServer?.link == s.link &&
                MainActivity.PROTO_XRAY == act?.protocol
            h.itemView.setBackgroundResource(
                if (selected) R.drawable.item_selected_bg else R.drawable.item_bg)

            h.itemView.setOnClickListener {
                act?.let {
                    it.selectServer(s)
                    it.protocol = MainActivity.PROTO_XRAY
                }
                notifyDataSetChanged()
            }
            h.itemView.setOnLongClickListener { showMenu(s); true }
        }

        private fun bindAWG(h: VH, awg: AWGConfig) {
            h.flag.text = "🔒"
            h.name.text = awg.name ?: "AWG"
            h.addr.text = awg.endpoint ?: ""
            h.ping.text = "AWG"
            h.ping.setTextColor(0xFF7B5CFF.toInt())
            h.aiScore?.visibility = View.GONE

            val selected = act?.currentAWG?.rawConf == awg.rawConf &&
                MainActivity.PROTO_AWG == act?.protocol
            h.itemView.setBackgroundResource(
                if (selected) R.drawable.item_selected_bg else R.drawable.item_bg)

            h.itemView.setOnClickListener {
                act?.let {
                    it.selectAWG(awg)
                    it.protocol = MainActivity.PROTO_AWG
                    AWGEditorBus.init(it.awgConfigs, awg, MainActivity.PROTO_AWG)
                }
                notifyDataSetChanged()
            }
            h.itemView.setOnLongClickListener { showMenu(awg); true }
        }

        private fun showMenu(target: Any) {
            if (!frag.isAdded) return
            val c = frag.context ?: return
            val items = ArrayList<String>()
            val actions = ArrayList<() -> Unit>()

            if (target is AWGConfig) {
                items.add("✏️ " + c.getString(R.string.dialog_edit))
                val idx = act?.awgConfigs?.indexOf(target) ?: -1
                actions.add {
                    if (idx >= 0 && frag.isAdded) {
                        val i = Intent(c, AWGEditorActivity::class.java)
                        i.putExtra(AWGEditorActivity.EXTRA_INDEX, idx)
                        i.putExtra(AWGEditorActivity.EXTRA_RAW, target.rawConf)
                        frag.startActivity(i)
                    }
                }
            }
            items.add("🗑 " + c.getString(R.string.dialog_delete))
            actions.add { confirmDelete(target) }

            AlertDialog.Builder(c)
                .setTitle(if (target is ServerItem) target.displayName()
                          else (target as AWGConfig).name)
                .setItems(items.toTypedArray()) { _, which ->
                    if (which in actions.indices) actions[which]()
                }
                .show()
        }

        private fun confirmDelete(target: Any) {
            if (!frag.isAdded) return
            val c = frag.context ?: return
            AlertDialog.Builder(c)
                .setTitle(R.string.dialog_delete)
                .setPositiveButton(R.string.dialog_yes) { _, _ ->
                    act?.let { a ->
                        when (target) {
                            is ServerItem -> {
                                a.servers.remove(target)
                                if (a.currentServer === target) {
                                    a.currentServer =
                                        if (a.servers.isEmpty()) null
                                        else a.servers[0]
                                    val newCur = a.currentServer
                                    if (newCur != null)
                                        a.selectServer(newCur)
                                    else a.prefs.edit()
                                        .remove("current_link").apply()
                                }
                                ServerStore.save(a, a.servers)
                            }
                            is AWGConfig -> {
                                a.awgConfigs.remove(target)
                                if (a.currentAWG === target) {
                                    a.currentAWG =
                                        if (a.awgConfigs.isEmpty()) null
                                        else a.awgConfigs[0]
                                    val newAwg = a.currentAWG
                                    if (newAwg != null)
                                        a.selectAWG(newAwg)
                                    else a.prefs.edit()
                                        .remove("current_awg").apply()
                                }
                                AWGStore.save(a, a.awgConfigs)
                                AWGEditorBus.init(a.awgConfigs, a.currentAWG,
                                    a.protocol)
                            }
                        }
                    }
                    notifyDataChanged()
                    frag.refresh()
                }
                .setNegativeButton(R.string.dialog_no, null)
                .show()
        }

        override fun getItemCount(): Int = shown.size

        inner class VH(v: View) : RecyclerView.ViewHolder(v) {
            val flag: TextView = v.findViewById(R.id.flag)
            val name: TextView = v.findViewById(R.id.name)
            val addr: TextView = v.findViewById(R.id.addr)
            val ping: TextView = v.findViewById(R.id.ping)
            val aiScore: TextView? = v.findViewById(R.id.ai_score)
            val fav: ImageView? = v.findViewById(R.id.fav)
        }
    }
}

