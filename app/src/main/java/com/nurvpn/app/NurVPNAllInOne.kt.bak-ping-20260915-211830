// 1. HomeFragment
// ═══════════════════════════════════════════════════════════════
class HomeFragment : Fragment() {

    private var connectBtn: View? = null
    private var connectIcon: TextView? = null
    private var pulseAnim: android.animation.ObjectAnimator? = null
    private var aiCard: AICardView? = null
    private var statusText: TextView? = null
    private var serverName: TextView? = null
    private var pingText: TextView? = null
    private var timerText: TextView? = null
    private var downText: TextView? = null
    private var upText: TextView? = null

    private val ui = Handler(Looper.getMainLooper())
    private var ai: AIServerSelector? = null
    private var tickerRunning = false
    private var analysisRunning = false

    private val ticker = object : Runnable {
        override fun run() {
            if (!isAdded) { tickerRunning = false; return }
            val a = activity as? MainActivity
            if (a == null) { ui.postDelayed(this, 1000); return }
            val start = a.connectStart
            val t = timerText
            if (a.isRunning && start > 0) {
                val sec = (System.currentTimeMillis() - start) / 1000
                t?.text = String.format(Locale.US, "%02d:%02d:%02d",
                    sec / 3600, (sec % 3600) / 60, sec % 60)
            } else {
                t?.text = "00:00:00"
            }
            ui.postDelayed(this, 1000)
        }
    }

    override fun onCreateView(
        inflater: LayoutInflater, container: ViewGroup?, savedInstanceState: Bundle?
    ): View? {
        val v = inflater.inflate(R.layout.fragment_home, container, false)
        connectBtn = v.findViewById(R.id.connect_btn)
        connectIcon = v.findViewById(R.id.connect_icon)
        aiCard = v.findViewById(R.id.ai_card)
        statusText = v.findViewById(R.id.status_text)
        serverName = v.findViewById(R.id.server_name)
        pingText = v.findViewById(R.id.ping_text)
        timerText = v.findViewById(R.id.timer_text)
        downText = v.findViewById(R.id.down_text)
        upText = v.findViewById(R.id.up_text)

        val appCtx = requireContext().applicationContext
        ai = AIServerSelector.get(appCtx)

        connectBtn?.setOnClickListener { toggleConnection() }

        aiCard?.setListener(object : AICardView.OnAutoConnect {
            override fun onAutoConnect(best: AIInsights?) {
                val a = activity as? MainActivity ?: return
                if (best == null) return
                var chosen: ServerItem? = null
                for (si in a.servers) {
                    if (si.link == best.link) { chosen = si; break }
                }
                if (chosen == null) return
                a.selectServer(chosen)
                a.protocol = MainActivity.PROTO_XRAY
                Toast.makeText(context,
                    getString(R.string.toast_ai_selected, chosen.displayName()),
                    Toast.LENGTH_SHORT).show()
                refresh()
                a.connectStart = System.currentTimeMillis()
                a.startVpn()
                ai?.onConnected(chosen)
            }

            override fun onRefreshRequested() = runAIAnalysis()
        })

        refresh()
        ui.postDelayed({ runAIAnalysis() }, 400)
        return v
    }

    private fun toggleConnection() {
        val a = activity as? MainActivity ?: return
        if (a.isRunning) {
            val curSrv = a.currentServer
            if (MainActivity.PROTO_XRAY == a.protocol && curSrv != null) {
                ai?.onDisconnected(curSrv, true)
            }
            a.stopVpn()
            a.connectStart = 0
        } else {
            if (MainActivity.PROTO_XRAY == a.protocol) {
                if (a.currentServer == null &&
                    a.servers.isEmpty()) {
                    Toast.makeText(context, R.string.toast_add_server_first,
                        Toast.LENGTH_SHORT).show()
                    return
                }
            }
            if (MainActivity.PROTO_AWG == a.protocol && a.currentAWG == null) {
                Toast.makeText(context, R.string.toast_add_awg_first,
                    Toast.LENGTH_SHORT).show()
                return
            }
            a.startVpn()
            a.connectStart = System.currentTimeMillis()
            val curSrv2 = a.currentServer
            if (MainActivity.PROTO_XRAY == a.protocol && curSrv2 != null) {
                ai?.onConnected(curSrv2)
            }
        }
        ui.postDelayed({ refresh() }, 600)
    }

    private fun runAIAnalysis() {
        if (!isAdded || aiCard == null || analysisRunning) return
        val a = activity as? MainActivity ?: return
        if (a.servers.isEmpty() || MainActivity.PROTO_AWG == a.protocol) {
            aiCard?.showRanked(Collections.emptyList())
            return
        }
        analysisRunning = true
        aiCard?.showAnalyzing()
        ai?.selectBest(a.servers, object : AIServerSelector.Listener {
            override fun onAnalysisStart() {}
            override fun onServerScored(s: ServerItem, score: Double) {}
            override fun onAnalysisComplete(ranked: List<AIInsights>) {
                analysisRunning = false
                if (!isAdded) return
                aiCard?.showRanked(ranked)
                refresh()
            }
            override fun onBestSelected(best: ServerItem, insights: AIInsights) {}
        })
    }

    fun refresh() {
        if (!isAdded) return
        val a = activity as? MainActivity ?: return
        connectBtn ?: return

        if (MainActivity.PROTO_AWG == a.protocol) {
            val awg = a.currentAWG
            serverName?.text = if (awg?.name != null) "🔒 ${awg.name}" else "🔒 AWG"
            pingText?.text = "AmneziaWG"
        } else {
            val srv = a.currentServer
            serverName?.text = if (srv != null)
                "${srv.flag()} ${srv.displayName()}"
            else getString(R.string.no_server_selected)
            pingText?.text = if (srv != null && srv.ping > 0 && srv.ping < 9999)
                "${srv.ping} ms" else "---"
        }

        if (a.isRunning) {
            statusText?.setText(R.string.status_connected)
            statusText?.setTextColor(0xFF4CD964.toInt())
            if (a.connectStart == 0L) a.connectStart = System.currentTimeMillis()
            // ⏹ Stop belgisi
            connectIcon?.text = "⏹"
            connectIcon?.textSize = 42f
            // Pulsatsiya animatsiyasi
            if (pulseAnim == null) {
                pulseAnim = android.animation.ObjectAnimator.ofFloat(
                    connectBtn, "scaleX", 1f, 1.08f, 1f)
                pulseAnim?.duration = 1500L
                pulseAnim?.repeatCount = android.animation.ValueAnimator.INFINITE
                pulseAnim?.repeatMode = android.animation.ValueAnimator.RESTART
                val anim2 = android.animation.ObjectAnimator.ofFloat(
                    connectBtn, "scaleY", 1f, 1.08f, 1f)
                anim2.duration = 1500L
                anim2.repeatCount = android.animation.ValueAnimator.INFINITE
                anim2.repeatMode = android.animation.ValueAnimator.RESTART
                pulseAnim?.start()
                anim2.start()
                connectBtn?.setTag(R.id.connect_btn, anim2)
            }
        } else {
            statusText?.setText(R.string.status_disconnected)
            statusText?.setTextColor(0xFF888888.toInt())
            a.connectStart = 0
            downText?.text = "0 KB/s"
            upText?.text = "0 KB/s"
            // ▶ Play belgisi
            connectIcon?.text = "▶"
            connectIcon?.textSize = 48f
            // Animatsiyani to'xtatamiz
            pulseAnim?.cancel()
            pulseAnim = null
            (connectBtn?.getTag(R.id.connect_btn) as? android.animation.ObjectAnimator)?.cancel()
            connectBtn?.scaleX = 1f
            connectBtn?.scaleY = 1f
        }
    }

    override fun onResume() {
        super.onResume()
        refresh()
        if (!tickerRunning) { tickerRunning = true; ui.post(ticker) }
    }

    override fun onPause() {
        super.onPause()
        tickerRunning = false
        ui.removeCallbacks(ticker)
    }

    override fun onDestroyView() {
        super.onDestroyView()
        tickerRunning = false
        ui.removeCallbacksAndMessages(null)
        connectBtn = null; aiCard = null
        statusText = null; serverName = null; pingText = null
        timerText = null; downText = null; upText = null
    }
}

