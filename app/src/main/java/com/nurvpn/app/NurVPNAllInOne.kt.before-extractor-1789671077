        row.findViewById<TextView>(R.id.row_name).text = si.displayName()
        row.findViewById<TextView>(R.id.row_host).text = si.host ?: ""
        val proto = row.findViewById<TextView>(R.id.row_proto)
        proto.text = protocolLabel(si.protocol)
